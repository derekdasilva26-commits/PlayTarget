# Tipo de banco de dados: sqlite (padrão para desenvolvimento) ou postgresql
DB_TYPE=sqlite

# URL do banco de dados
# SQLite (desenvolvimento local — sem instalação necessária):
DATABASE_URL=sqlite:///./playtarget.db

# PostgreSQL (produção):
# DB_TYPE=postgresql
# DATABASE_URL=postgresql+psycopg2://playtarget_user:playtarget_pass@localhost:5432/playtarget

# Chave secreta para assinar tokens JWT (TROQUE EM PRODUÇÃO!)
SECRET_KEY=playtarget-secret-key-change-in-production
