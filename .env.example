# Tipo de banco de dados: "duckdb" (padrão, sem dependências externas) ou "postgresql"
DB_TYPE=duckdb

# URL de conexão com o banco de dados
# DuckDB (padrão local):
DATABASE_URL=duckdb:///playtarget.duckdb

# PostgreSQL (produção):
# DATABASE_URL=postgresql+psycopg2://playtarget_user:playtarget_pass@localhost:5432/playtarget

# Chave secreta para assinar tokens JWT (alterar em produção!)
SECRET_KEY=playtarget-secret-key-change-in-production
